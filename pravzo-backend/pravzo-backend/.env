# ── Single Server Port ────────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Mysql@123
DB_NAME=pravzo_db
# Production: set DB_POOL_SIZE=50, DB_SSL=true
DB_POOL_SIZE=20
DB_SSL=false

# ── Business Config ────────────────────────────────────────────────────────────
# Platform commission on booking completion (0.10 = 10%)
PLATFORM_COMMISSION_RATE=0.10

# ── Redis ─────────────────────────────────────────────────────────────────────
USE_REDIS=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_PREFIX=pravzo

# ── JWT — Admin (access+refresh tokens, stored in httpOnly cookies) ───────────
JWT_ACCESS_SECRET=482785c5c71b51ed1ff533209ab566b7b09b2cce9c360a9a3bb0228fc8906c9e8ab7c53820205ecf856875f6a5733d8d869c6acb0fc7998aad8335a0109928f9
JWT_REFRESH_SECRET=0166bc354a5f33583357e71403311e38b387f4e973bbfc4bf8cae1928695868e615b847cf5ea1d503b168f9298bbf6cd920ebfb442326694e3d79dd7c1908119
JWT_ACCESS_EXPIRES_IN=55m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=7e4eb4159bb218b38fc772c51ffa86dab7e25c8efb0616df849e31ad2c6ef649

# ── JWT — User/Rider (single long-lived token, sent as Bearer header) ─────────
JWT_SECRET=91f326d87f3552c753807ce2fe01df3122e85a66d6cbed90446b8a932692b800ba03576e6813dc6c5aaa3718c1f2d0a1cee303ea96409bc5306ad9ab466e47a3
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Admin panel origins + User app origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# ── MinIO (file storage) ──────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=pravzo-uploads
MINIO_USE_SSL=false

# ── Email (admin notifications, OTP) ─────────────────────────────────────────
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=admin@pravzo.com
EMAIL_PASSWORD=any_password
EMAIL_FROM=Pravzo <noreply@pravzo.com>

# ── OTP Settings ──────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
TEST_MODE=true
SMS_PROVIDER=console

# ── Razorpay (user checkout payments) ────────────────────────────────────────
RAZORPAY_KEY_ID= 
RAZORPAY_KEY_SECRET= 
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── RazorpayX (rider cashout/payouts) ────────────────────────────────────────
USE_MOCK_RAZORPAYX=true
RAZORPAYX_WEBHOOK_SECRET=mock_secret
MOCK_PAYOUT_STATUS=processed
BASE_URL=http://localhost:5000

# ── Payment Provider ──────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock
