{
	"info": {
		"_postman_id": "a7b89012-3456-7890-1234-567890123456",
		"name": "Pravzo Jobs & Delivery Operations Flow",
		"description": "Postman Collection for Pravzo Backend - Delivery Jobs Ecosystem (Rider Available Jobs, Accept Job, Complete Job & Earnings).\n\nFlow covered:\n1. Rider Fetch Available Delivery Jobs (`GET /api/jobs/available`)\n2. Rider Accept Delivery Job (`POST /api/jobs/:jobId/accept`)\n3. Rider Mark Job Completed (`PUT /api/jobs/:jobId/complete`)\n4. Rider / Admin View Assigned Job History (`GET /api/jobs/user/:userId`)",
		"schema": "https://getpostman.com/schemas/v1.0.0/collection.json"
	},
	"item": [
		{
			"name": "1. Delivery Jobs Lifecycle",
			"item": [
				{
					"name": "Get Available Delivery Jobs",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{user_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/jobs/available",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs",
								"available"
							]
						},
						"description": "Rider fetches list of nearby available delivery jobs."
					},
					"response": []
				},
				{
					"name": "Accept Delivery Job",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{user_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/jobs/1/accept",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs",
								"1",
								"accept"
							]
						},
						"description": "Rider accepts a delivery job."
					},
					"response": []
				},
				{
					"name": "Complete Delivery Job",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{user_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"proof_of_delivery_url\": \"https://pravzo.com/uploads/pod-101.jpg\",\n  \"remarks\": \"Package handed over to recipient\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/jobs/1/complete",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs",
								"1",
								"complete"
							]
						},
						"description": "Rider completes job and submits proof of delivery."
					},
					"response": []
				},
				{
					"name": "Get User / Rider Job History",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{user_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/jobs/user/{{user_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"jobs",
								"user",
								"{{user_id}}"
							]
						},
						"description": "Get history of completed and active jobs for a rider."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3000",
			"type": "string"
		}
	]
}
