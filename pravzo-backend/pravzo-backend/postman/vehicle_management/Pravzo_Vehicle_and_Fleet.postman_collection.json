						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"registration_number\": \"DL01EV2026\",\n  \"vehicle_number\": \"EV-SCOOTER-101\",\n  \"model\": \"Ather 450X\",\n  \"brand\": \"Ather Energy\",\n  \"vehicle_type\": \"SCOOTER\",\n  \"battery_capacity\": \"3.7 kWh\",\n  \"max_range_km\": 110,\n  \"current_battery_level\": 100,\n  \"status\": \"AVAILABLE\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/vehicles",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"vehicles"
							]
						},
						"description": "Create a new EV vehicle and save vehicle_id."
					},
					"response": []
				},
