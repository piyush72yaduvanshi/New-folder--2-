{
	"info": {
		"_postman_id": "d4e5f6a7-b890-1234-def5-678901234567",
		"name": "Pravzo Vehicle & Fleet Management Flow",
		"description": "Postman Collection for Pravzo Backend - Vehicle Catalog, Fleet Operations, Branch Assignment & Maintenance Lifecycle.\n\nFlow covered:\n1. Public / User Vehicle APIs (`/api/vehicles`)\n2. Admin Vehicle Management (`/api/admin/vehicles` - Add, Update, Status, Documents)\n3. Branch & Rider Vehicle Assignment (`/api/admin/vehicles/:id/assign-branch`, `/api/admin/vehicles/:id/assign-rider`)\n4. Vehicle Maintenance Lifecycle (`/api/admin/vehicles/:id/start-maintenance`, `complete-maintenance`)\n5. Enterprise Fleet Tracking & Operations (`/api/admin/fleet/dashboard`, `live-locations`, `availability`, `bulk-assign`)",
		"schema": "https://getpostman.com/schemas/v1.0.0/collection.json"
	},
	"item": [
		{
			"name": "1. Public / User Vehicle APIs",
			"item": [
				{
					"name": "Get All Available Vehicles",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/vehicles",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"vehicles"
							]
						},
						"description": "Get list of all public/active vehicles available for booking or rental."
					},
					"response": []
				},
