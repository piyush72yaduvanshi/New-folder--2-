{
	"info": {
		"_postman_id": "c3d4e5f6-a7b8-9012-cdef-345678901234",
		"name": "Pravzo Rider Application & Branch Assignment Flow",
		"description": "Postman Collection for Pravzo Backend - Rider Lifecycle (User Application -> Admin Approval -> Branch Assignment -> Vehicle Assignment -> Status Update).\n\nFlow covered:\n1. User Rider Application (`/api/riders/apply`, `/api/riders/:id/application-status`, `/api/riders/verify-code`)\n2. Admin Branch Management (`/api/super-admin/branches`)\n3. Admin Rider Approval & KYC Verification (`/api/admin/riders/:id/verify-kyc`)\n4. Admin Assign Branch & Transfer Branch (`/api/admin/riders/:id/assign-branch`)\n5. Admin Assign Vehicle & Manage Rider Status (`/api/admin/riders/:id/assign-vehicle`, `/api/admin/riders/:id/status`)",
		"schema": "https://getpostman.com/schemas/v1.0.0/collection.json"
	},
	"item": [
		{
			"name": "1. User - Rider Application Flow",
			"item": [
				{
					"name": "Submit Rider Application",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{user_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"father_name\": \"Ramesh Kumar\",\n  \"emergency_contact\": \"9876543211\",\n  \"driving_license_number\": \"DL1420110012345\",\n  \"aadhaar_number\": \"123456789012\",\n  \"pan_number\": \"ABCDE1234F\",\n  \"city\": \"Delhi\",\n  \"address\": \"H.No 12, Connaught Place, New Delhi\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/riders/apply",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"riders",
								"apply"
							]
						},
						"description": "User submits application to become a rider."
					},
					"response": []
