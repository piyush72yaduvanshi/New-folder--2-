							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rider_code\": \"RIDER-1001\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/riders/verify-code",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"riders",
								"verify-code"
							]
						},
						"description": "Verifies joining code and upgrades user role to RIDER."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Admin - Branch Management Flow",
			"item": [
				{
					"name": "Create New Branch",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.branch_id) {",
									"    pm.environment.set(\"branch_id\", jsonData.data.branch_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}",
									"type": "string"
