						"body": {
							"mode": "raw",
							"raw": "{\n  \"branch_name\": \"Connaught Place Branch\",\n  \"branch_code\": \"DEL-CP-01\",\n  \"admin_id\": 1,\n  \"branch_type\": \"MAIN\",\n  \"city\": \"Delhi\",\n  \"state\": \"Delhi\",\n  \"pin_code\": \"110001\",\n  \"email\": \"cp.branch@pravzo.com\",\n  \"phone_number\": \"9811122233\"\n}"
						},
