							"raw": "{{base_url}}/api/wallet/cashout",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"wallet",
								"cashout"
							]
						},
						"description": "Rider requests instant cashout transfer to registered bank account."
					},
					"response": []
				}
			]
		},
