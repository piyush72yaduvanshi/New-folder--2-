								{
									"key": "token",
									"value": "{{user_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"razorpay_order_id\": \"{{razorpay_order_id}}\",\n  \"razorpay_payment_id\": \"pay_test12345678\",\n  \"razorpay_signature\": \"test_signature_hash\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/wallet/verify-topup",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"wallet",
								"verify-topup"
							]
						},
						"description": "Verifies payment signature and credits funds to user wallet."
					},
					"response": []
				},
