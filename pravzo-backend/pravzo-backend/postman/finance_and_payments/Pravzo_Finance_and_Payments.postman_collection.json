{
	"info": {
		"_postman_id": "f6a7b890-1234-5678-9012-345678901234",
		"name": "Pravzo Finance, Payments & Wallet Flow",
		"description": "Postman Collection for Pravzo Backend - User Wallet Operations, Razorpay Payments Gateway & Super Admin Enterprise Finance, Ledger & Settlements.\n\nFlow covered:\n1. User Wallet Topup & Razorpay Integration (`/api/wallet/topup-order`, `/api/wallet/verify-topup`)\n2. Rider Cashout / Instant Payout (`/api/wallet/cashout`)\n3. User Wallet Balance & Transactions (`/api/wallet/:userId`, `/api/wallet/transactions/:userId`)\n4. Super Admin Wallet Credit/Debit Operations (`/api/super-admin/wallets/:id/credit`, `debit`)\n5. Super Admin Settlements (`/api/super-admin/settlements/run`, `process`, `complete`)\n6. Super Admin Financial Accounting Ledger & Trial Balance (`/api/super-admin/ledger/trial-balance`, `accounts`, `entries`)",
		"schema": "https://getpostman.com/schemas/v1.0.0/collection.json"
	},
	"item": [
		{
			"name": "1. User Wallet Topup & Payments (Razorpay)",
			"item": [
				{
					"name": "Create Wallet Topup Order",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.order_id) {",
									"    pm.environment.set(\"razorpay_order_id\", jsonData.data.order_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{user_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount\": 1000.00\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/wallet/topup-order",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"wallet",
								"topup-order"
							]
						},
						"description": "User initiates wallet recharge order with Razorpay."
					},
					"response": []
				},
				{
					"name": "Verify Wallet Topup Payment",
					"request": {
						"auth": {
							"type": "bearer",
