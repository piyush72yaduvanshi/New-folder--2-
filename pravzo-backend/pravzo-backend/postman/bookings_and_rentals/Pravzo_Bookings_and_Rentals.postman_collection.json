{
	"info": {
		"_postman_id": "e5f6a7b8-9012-3456-ef67-890123456789",
		"name": "Pravzo Bookings & Rentals Flow",
		"description": "Postman Collection for Pravzo Backend - End to End Booking Lifecycle, Admin Rider Assignment, Operations (Start/Complete/Reschedule), and Rental Pickup/Return Flow.\n\nFlow covered:\n1. User Create Booking (`POST /api/bookings`)\n2. User Get Bookings & Agreement (`GET /api/bookings/user/:userId`, `/api/bookings/:id/agreement`)\n3. Admin Booking Management (`GET /api/admin/bookings`, `statistics`, `analytics/revenue`)\n4. Admin Assign Rider to Booking (`PATCH /api/admin/bookings/:id/assign-rider`)\n5. Admin Operations (`manual-start`, `manual-arrival`, `manual-complete`, `reschedule`, `cancel`, `refund`)\n6. Admin Rental Operations (`pickup`, `return`, `extend`, `inspection`)",
		"schema": "https://getpostman.com/schemas/v1.0.0/collection.json"
	},
	"item": [
		{
			"name": "1. User Booking Creation & Details",
			"item": [
				{
					"name": "Create New Booking (User)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.booking_id) {",
									"    pm.environment.set(\"booking_id\", jsonData.data.booking_id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{user_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"vehicle_id\": 1,\n  \"start_date\": \"2026-08-15\",\n  \"end_date\": \"2026-08-20\",\n  \"reference_id\": \"REF-BK-20260815-01\",\n  \"security_deposit\": 2000.00\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/bookings",
							"host": [
								"{{base_url}}"
							],
							"path": [
