{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Pravzo Auth & KYC Verification Flow",
		"description": "Postman Collection for Pravzo Backend - End to End Authentication and KYC Verification Flow.\n\nFlow covered:\n1. User Registration (`/api/auth/register`)\n2. User Login (`/api/auth/login`)\n3. User Profile Fetch (`/api/users/:id`)\n4. Admin Login (`/api/admin/login`)\n5. Admin Profile Fetch (`/api/admin/profile`)\n6. Admin KYC - Get Pending Documents (`/api/admin/kyc/pending`)\n7. Admin KYC - Approve KYC (`/api/admin/kyc/approve`)\n8. Admin KYC - Reject KYC (`/api/admin/kyc/reject`)",
		"schema": "https://getpostman.com/schemas/v1.0.0/collection.json"
	},
	"item": [
		{
			"name": "1. User Flow",
			"item": [
				{
					"name": "User Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    if (jsonData.data.token) {",
									"        pm.environment.set(\"user_token\", jsonData.data.token);",
									"    }",
									"    if (jsonData.data.user && jsonData.data.user.user_id) {",
									"        pm.environment.set(\"user_id\", jsonData.data.user.user_id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"full_name\": \"Test User\",\n  \"mobile_number\": \"9876543210\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password@123\",\n  \"gender\": \"MALE\",\n  \"date_of_birth\": \"1998-05-15\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Registers a new user and automatically sets user_token and user_id in the environment."
					},
					"response": []
				},
				{
					"name": "User Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data) {",
									"    if (jsonData.data.token) {",
									"        pm.environment.set(\"user_token\", jsonData.data.token);",
									"    }",
									"    if (jsonData.data.user && jsonData.data.user.user_id) {",
									"        pm.environment.set(\"user_id\", jsonData.data.user.user_id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mobile_number\": \"9876543210\",\n  \"password\": \"Password@123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Log in with mobile_number and password. Saves token to user_token."
					},
					"response": []
				},
				{
					"name": "Send OTP (Mobile)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mobile\": \"9876543210\",\n  \"purpose\": \"login\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/send-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"send-otp"
							]
						},
						"description": "Sends OTP to user mobile for login/verification."
					},
					"response": []
				},
				{
					"name": "Verify OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.token) {",
									"    pm.environment.set(\"user_token\", jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"mobile\": \"9876543210\",\n  \"otp\": \"123456\",\n  \"purpose\": \"login\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/verify-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"verify-otp"
							]
						},
						"description": "Verifies OTP and returns user_token if purpose is login."
					},
					"response": []
				},
				{
					"name": "Get User Profile",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{user_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/users/{{user_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"users",
								"{{user_id}}"
							]
						},
						"description": "Get current logged-in user profile details."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Admin Flow",
			"item": [
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data && jsonData.data.accessToken) {",
									"    pm.environment.set(\"admin_token\", jsonData.data.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@pravzo.com\",\n  \"password\": \"Admin@123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"login"
							]
						},
						"description": "Logs in admin and sets admin_token in the environment."
					},
					"response": []
				},
				{
					"name": "Get Admin Profile",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/profile",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"profile"
							]
						},
						"description": "Fetches admin profile information using admin_token."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Admin KYC Verification Flow",
			"item": [
				{
					"name": "Get Pending KYC List",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/kyc/pending?page=1&limit=10",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"kyc",
								"pending"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Fetches all pending KYC document requests for admin verification."
					},
					"response": []
				},
				{
					"name": "Get KYC Statistics",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/kyc/statistics",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"kyc",
								"statistics"
							]
						},
						"description": "Get summary metrics of KYC verifications (Pending, Verified, Rejected)."
					},
					"response": []
				},
				{
					"name": "Get KYC Detail By ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/kyc/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"kyc",
								"1"
							]
						},
						"description": "Fetches full details of a specific KYC document request."
					},
					"response": []
				},
				{
					"name": "Approve KYC Document",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"documentId\": 1,\n  \"remarks\": \"KYC documents verified and approved successfully by Admin.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/kyc/approve",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"kyc",
								"approve"
							]
						},
						"description": "Approve a user's KYC document."
					},
					"response": []
				},
				{
					"name": "Reject KYC Document",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{admin_token}}",
									"type": "string"
								}
							]
						},
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"documentId\": 1,\n  \"reason\": \"Image blurred\",\n  \"remarks\": \"Aadhaar front image is not clear. Please upload a high resolution photo.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/kyc/reject",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"admin",
								"kyc",
								"reject"
							]
						},
						"description": "Reject a user's KYC document with reason and remarks."
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3000",
			"type": "string"
		}
	]
}
