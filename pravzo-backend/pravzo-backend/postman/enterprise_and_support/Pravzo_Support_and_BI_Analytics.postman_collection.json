								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"latitude\": 28.6328,\n  \"longitude\": 77.2197,\n  \"message\": \"Immediate assistance needed! Vehicle accident.\"\n}"
