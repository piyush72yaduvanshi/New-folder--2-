{
	"info": {
		"_postman_id": "b8901234-5678-9012-3456-789012345678",
		"name": "Pravzo Support, SOS Emergency & BI Analytics Flow",
		"description": "Postman Collection for Pravzo Backend - Rider Breakdown Support, SOS Emergency Triggers, Admin Alert Resolution & Business Intelligence (BI) Analytics.\n\nFlow covered:\n1. User Submit Vehicle Breakdown Report (`POST /api/breakdown-reports`)\n2. User Trigger SOS Emergency Alert (`POST /api/sos/alert`)\n3. Admin Resolve SOS Emergency Alert (`PUT /api/sos/:id/resolve`)\n4. Super Admin BI Dashboard & Analytics (`/api/super-admin/dashboard`, `/analytics`, `/reports`)",
		"schema": "https://getpostman.com/schemas/v1.0.0/collection.json"
	},
	"item": [
		{
			"name": "1. User Support & Emergency SOS",
			"item": [
				{
					"name": "Report Vehicle Breakdown (User)",
