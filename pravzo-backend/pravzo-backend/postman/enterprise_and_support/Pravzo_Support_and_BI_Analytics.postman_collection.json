							"raw": "{\n  \"vehicle_id\": 1,\n  \"issue_type\": \"FLAT_TYRE\",\n  \"description\": \"Front tyre punctured near Rajiv Chowk Metro Gate 3\",\n  \"latitude\": 28.6328,\n  \"longitude\": 77.2197\n}"
