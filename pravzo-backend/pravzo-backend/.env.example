# ── Single Server Port ────────────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ── MySQL Database ────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=pravzo_db
# Production: set DB_POOL_SIZE=50, DB_SSL=true
DB_POOL_SIZE=20
DB_SSL=false

# ── Business Config ────────────────────────────────────────────────────────────
# Platform commission on booking completion (0.10 = 10%)
PLATFORM_COMMISSION_RATE=0.10

# ── Redis ─────────────────────────────────────────────────────────────────────
USE_REDIS=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=pravzo

# ── JWT — Admin (access+refresh tokens, stored in httpOnly cookies) ───────────
JWT_ACCESS_SECRET=GENERATE_WITH_crypto.randomBytes(64).toString('hex')
JWT_REFRESH_SECRET=GENERATE_DIFFERENT_FROM_ACCESS
JWT_ACCESS_EXPIRES_IN=55m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=GENERATE_WITH_crypto.randomBytes(32).toString('hex')

# ── JWT — User/Rider (single long-lived token, sent as Bearer header) ─────────
JWT_SECRET=GENERATE_DIFFERENT_FROM_ALL_ADMIN_SECRETS
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Admin panel origins + User app origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# ── MinIO (file storage) ──────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=pravzo-uploads
MINIO_USE_SSL=false

# ── Email (admin notifications, OTP) ─────────────────────────────────────────
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=admin@pravzo.com
EMAIL_PASSWORD=any_password
EMAIL_FROM=Pravzo <noreply@pravzo.com>

# ── OTP Settings ──────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
TEST_MODE=true
SMS_PROVIDER=console

# ── Razorpay (user checkout payments) ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── RazorpayX (rider cashout/payouts) ────────────────────────────────────────
USE_MOCK_RAZORPAYX=true
RAZORPAYX_WEBHOOK_SECRET=mock_secret
MOCK_PAYOUT_STATUS=processed
BASE_URL=http://localhost:5000

# ── Payment Provider ──────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mock
