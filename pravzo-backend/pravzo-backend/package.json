{
  "name": "pravzo-backend",
  "version": "2.0.0",
  "description": "Pravzo Unified Backend — Admin Panel + User/Rider App (single server)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/migrate.js",
    "db:setup": "node scripts/runAllTables.js",
    "db:unified": "node scripts/runUnifiedMigration.js",
    "seed": "node scripts/seed.js",
    "verify": "node scripts/verify_db.js",

    "test":            "jest --detectOpenHandles --forceExit",
    "test:unit":       "jest --testPathPatterns=tests/unit --detectOpenHandles --forceExit",
    "test:smoke":      "jest --testPathPatterns=tests/smoke --detectOpenHandles --forceExit",
    "test:regression": "jest --testPathPatterns=tests/regression --detectOpenHandles --forceExit",
    "test:security":   "jest --testPathPatterns=tests/security --detectOpenHandles --forceExit",
    "test:workflow":   "jest --testPathPatterns=tests/workflows --detectOpenHandles --forceExit --runInBand",
    "test:integration":"jest --testPathPatterns=tests/integration --detectOpenHandles --forceExit",
    "test:critical":   "jest --testPathPatterns=\"tests/(smoke|regression|security)\" --detectOpenHandles --forceExit",
    "test:all":        "jest --detectOpenHandles --forceExit"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.0",
    "express-slow-down": "^3.1.0",
    "express-validator": "^7.0.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.2",
    "minio": "^7.1.3",
    "multer": "^2.1.1",
    "mysql2": "^3.9.7",
    "nodemailer": "^6.9.8",
    "pdfkit": "0.15.0",
    "razorpay": "^2.9.6",
    "redis": "^4.7.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
